		},
		"events": {
			"include": ["tool_call_start", "tool_call_complete", "artifact_created", "session_memory_updated"]
		},
		"finalOutput": {
			"mustNotInclude": ["是否现在执行", "是否需要我检索", "should I run the search"]
		}
	}
}
