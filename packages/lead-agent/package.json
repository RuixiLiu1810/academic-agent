{
	"name": "@mariozechner/pi-lead-agent",
	"version": "0.73.0",
	"description": "Lead orchestration agent for academic research and writing workflows",
	"type": "module",
	"bin": {
		"pi-lead": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"profiles",
		"scenarios",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"check": "tsgo --noEmit",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@mariozechner/pi-agent-contracts": "^0.73.0",
		"@mariozechner/pi-agent-host": "^0.73.0",
		"@mariozechner/pi-ai": "^0.73.0",
		"@mariozechner/pi-artifact-core": "^0.73.0",
		"@mariozechner/pi-coding-agent": "^0.73.0",
		"@mariozechner/pi-tui": "^0.73.0",
		"chalk": "^5.5.0",
		"typebox": "^1.1.24"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"shx": "^0.4.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"agent",
		"academic",
		"orchestration"
	],
	"author": "Mario Zechner",
