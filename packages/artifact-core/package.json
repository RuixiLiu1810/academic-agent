{
	"name": "@mariozechner/pi-artifact-core",
	"version": "0.73.0",
	"description": "Artifact storage, versioning, and lineage primitives for pi agent workflows",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"check": "tsgo --noEmit",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@mariozechner/pi-agent-contracts": "^0.73.0"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"shx": "^0.4.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"agent",
		"artifact",
		"lineage"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	}
}
